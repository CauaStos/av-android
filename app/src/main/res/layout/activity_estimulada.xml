<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pesquisa estimulada"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agora, entre estes candidatos, em quem você votaria?"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <RadioGroup
            android:id="@+id/grupoCandidatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbAnakin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Anakin Skywalker" />

            <RadioButton
                android:id="@+id/rbLeia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Leia Organa" />

            <RadioButton
                android:id="@+id/rbHan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Han Solo" />

            <RadioButton
                android:id="@+id/rbChewbacca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chewbacca" />

            <RadioButton
                android:id="@+id/rbR2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="R2-D2" />

        </RadioGroup>

        <Button
            android:id="@+id/botaoAvancar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Avançar"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
